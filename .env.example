from src.core.email_checker import check_email


def test_check_email_invalid_format():
    result = check_email("bad-email", "secret")
    assert result["status"] == "invalid"
    assert result["is_valid_format"] is False


def test_check_email_known_provider(monkeypatch):
    def fake_login(email: str, password: str, host: str, port: int = 993, timeout: float = 5.0):
        return {"success": True, "response_time": 0.1, "provider_status": "reachable"}

    monkeypatch.setattr("src.core.email_checker.imap_login_check", fake_login)
    monkeypatch.setattr("src.core.email_checker.smtp_login_check", fake_login)
    result = check_email("user@gmail.com", "pass123")
    assert result["provider"] == "gmail"
    assert result["status"] in {"active", "inactive", "invalid", "error"}
